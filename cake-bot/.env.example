# Скопируй этот файл в .env и заполни значения.
# .env никогда не коммитится (см. .gitignore).

# --- Бот ---
# Токен от @BotFather. Тот же токен вписан в API как TGS_CAKE_BOT_TOKEN.
BOT_TOKEN=

# Telegram id руководителей через запятую — им утренняя сводка и все уведомления.
# Узнать свой id: написать боту /id. Тот же список — в API как TGS_CAKE_ADMINS.
ADMIN_IDS=

# --- API склада (крутится на этом же iMac) ---
# Порт 8098: на iMac 8097 занят витриной studio (~/tgstudio-bot).
API_URL=http://127.0.0.1:8098/api/cake
# Служебный ключ: длинная случайная строка (openssl rand -hex 24).
# Та же строка — в API как TGS_CAKE_SERVICE_KEY.
SERVICE_KEY=

# --- Где лежат страницы Mini App (GitHub Pages) ---
WEBAPP_BASE=https://birsiti.github.io/TG-Studio/cake-warehouse

# --- Расписание ---
# Утренняя сводка руководителю (по умолчанию 07:00)
DIGEST_CRON=0 7 * * *
# Как часто проверять рейсы для уведомлений, секунд
WATCH_SECONDS=60
TIMEZONE=Europe/Minsk

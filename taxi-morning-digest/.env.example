# Скопируй этот файл в .env и заполни значения.
# .env никогда не коммитится (см. .gitignore).

# --- Юзербот-сессия (аккаунт, который состоит в чате t.me/taxichat_by) ---
# Получить TELEGRAM_API_ID и TELEGRAM_API_HASH: https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Заполняется автоматически командой `npm run login` (один раз)
TELEGRAM_SESSION=

# Чат-источник, который парсим. Можно @username или числовой id.
SOURCE_CHAT=taxichat_by

# --- Бот, который присылает сводку ---
# Токен от @BotFather (/newbot)
DIGEST_BOT_TOKEN=
# chat_id главного (кому слать сводку). Узнать: написать этому боту /start,
# затем открыть https://api.telegram.org/bot<TOKEN>/getUpdates и взять "chat":{"id": ...}
BOSS_CHAT_ID=

# --- Сводка через Claude (опционально, но сильно рекомендуется) ---
# Если не задать — бот пришлёт просто сгруппированный список сообщений без ИИ-выжимки
ANTHROPIC_API_KEY=

# --- Расписание ---
# Cron-выражение времени утренней сводки (по умолчанию 07:00)
DIGEST_CRON=0 7 * * *
# Таймзона для cron и группировки "за сутки"
TIMEZONE=Europe/Minsk

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Страница не найдена | TG-Studio" description="Запрошенная страница не найдена." path="/404">
  <main id="main-content">
    <section class="page-hero">
      <div class="wrap" style="text-align:center;">
        <div class="eyebrow" style="justify-content:center;">404</div>
        <h1>Страница не найдена</h1>
        <p class="lead" style="margin-left:auto; margin-right:auto;">Возможно, ссылка устарела. Вернитесь на главную или посмотрите наши услуги.</p>
        <div class="hero-cta" style="justify-content:center;">
          <a href="/" class="btn btn-primary">На главную</a>
          <a href="/novosti" class="btn btn-ghost">Новости</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
